# PantrySnap server
PORT=8787

# --- Chat assistant (/api/chat) ---
# DeepSeek powers chat when set (OpenAI-compatible). https://platform.deepseek.com
# Falls back to Gemini if left blank.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini (photo detection + recipe generation): pick ONE mode ---

# Mode 1: AI Studio (simple key, free tier). Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mode 2: Vertex AI (bills your Cloud project — $300 free-trial credits apply here).
# Authenticate locally with: gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Supabase — verifies user tokens to gate AI endpoints (cost/abuse control).
# When set, AI routes require a signed-in user. Get from Supabase: Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Max AI requests per user per minute.
AI_RATE_LIMIT_PER_MIN=20

# Optional richer recipes. TheMealDB works with no key.
SPOONACULAR_API_KEY=
