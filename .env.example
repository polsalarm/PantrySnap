# PantrySnap frontend (Vite) env

# Phase 5/6 backend proxy base. Default '/api' uses the dev proxy (vite.config.ts).
# In prod, set to the deployed server/ URL, e.g. https://api.pantrysnap.app/api
VITE_API_BASE=/api

# Phase 8 cloud sync (Supabase). Leave empty to keep the app fully local-first.
# Get these from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
